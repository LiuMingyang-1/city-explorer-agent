{
  "schema_version": "xian-collection-task/1",
  "mode": "supplement",
  "profile_id": "xian-nightly-discovery",
  "city": "西安市",
  "keyword_city": "西安",
  "timezone": "Asia/Shanghai",
  "keyword_library": "configs/collection.keyword-library.json",
  "engines": [
    {
      "name": "xiaohongshu",
      "enabled": true,
      "search_method": "keyword_library",
      "limit": 20,
      "keyword_rules": {
        "strategy": "weekday_groups",
        "queries_per_run": 4,
        "results_per_query": 5,
        "weekday_groups": {
          "1": [
            "xhs_exhibitions",
            "xhs_markets",
            "xhs_new_places",
            "xhs_performances",
            "xhs_weekend",
            "xhs_family",
            "xhs_new_venues"
          ],
          "2": [
            "xhs_markets",
            "xhs_new_places",
            "xhs_performances",
            "xhs_weekend",
            "xhs_family",
            "xhs_new_venues",
            "xhs_exhibitions"
          ],
          "3": [
            "xhs_new_places",
            "xhs_performances",
            "xhs_weekend",
            "xhs_family",
            "xhs_new_venues",
            "xhs_exhibitions",
            "xhs_markets"
          ],
          "4": [
            "xhs_performances",
            "xhs_weekend",
            "xhs_family",
            "xhs_new_venues",
            "xhs_exhibitions",
            "xhs_markets",
            "xhs_new_places"
          ],
          "5": [
            "xhs_weekend",
            "xhs_family",
            "xhs_new_venues",
            "xhs_exhibitions",
            "xhs_markets",
            "xhs_new_places",
            "xhs_performances"
          ],
          "6": [
            "xhs_family",
            "xhs_new_venues",
            "xhs_exhibitions",
            "xhs_markets",
            "xhs_new_places",
            "xhs_performances",
            "xhs_weekend"
          ],
          "7": [
            "xhs_new_venues",
            "xhs_exhibitions",
            "xhs_markets",
            "xhs_new_places",
            "xhs_performances",
            "xhs_weekend",
            "xhs_family"
          ]
        },
        "scope": "city",
        "contextual": {
          "enabled": true,
          "every_n_runs": 4,
          "max_queries_per_run": 1,
          "replacement": "replace_regular_query",
          "priority": [
            "holiday",
            "seasonal"
          ],
          "seasonal_group": "xhs_seasonal",
          "holiday_group": "xhs_holiday"
        }
      }
    },
    {
      "name": "deepseek",
      "enabled": true,
      "search_method": "keyword_library",
      "limit": 20,
      "keyword_rules": {
        "strategy": "slots",
        "results_per_query": 5,
        "slots": [
          {
            "id": "events_citywide",
            "groups": [
              "deepseek_exhibitions",
              "deepseek_markets",
              "deepseek_performances",
              "deepseek_culture",
              "deepseek_family"
            ],
            "queries_per_run": 2,
            "scope": "city"
          },
          {
            "id": "places_regional",
            "groups": [
              "deepseek_new_places",
              "deepseek_new_venues"
            ],
            "queries_per_run": 2,
            "scope": "rotating_area"
          }
        ],
        "contextual": {
          "enabled": true,
          "every_n_runs": 2,
          "max_queries_per_run": 1,
          "replacement": "round_robin_within_matching_slot",
          "priority": [
            "holiday",
            "seasonal"
          ],
          "seasonal_group": "deepseek_seasonal",
          "seasonal_slot": "places_regional",
          "holiday_group": "deepseek_holiday",
          "holiday_slot": "events_citywide"
        }
      }
    }
  ],
  "collection_defaults": {
    "output_dir": ".local-data/xian/scheduled/runs",
    "publish_root": ".local-data/xian/real-release",
    "processing": {
      "enabled": true,
      "ocr": true,
      "attraction_duplicate_meters": 10,
      "ocr_max_images": 20
    },
    "budgets": {
      "model_requests": 200,
      "map_requests": 200,
      "level_searches": 30
    },
    "database_path": "data/events.db"
  },
  "state_file": ".local-data/xian/scheduled/state.json",
  "schedule": {
    "enabled": false,
    "backend": "windows_task_scheduler",
    "task_name": "CityExplorerNightlyDiscovery",
    "poll_minutes": 5,
    "at": "23:30",
    "weekdays": [
      1,
      2,
      3,
      4,
      5,
      6,
      7
    ],
    "search_anchor_day_offset": 1,
    "catch_up_window_minutes": 120,
    "max_run_minutes": 60
  }
}
