{
  "name": "city-explorer-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI agent that plans city outings from a SQLite event database (v0).",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/cli/main.ts",
    "start": "node --env-file-if-exists=.env src/cli/main.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
