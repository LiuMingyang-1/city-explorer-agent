# Required: model API key. OPENAI_API_KEY or ANTHROPIC_API_KEY are used as fallback
# depending on EXPLORER_PROVIDER.
EXPLORER_API_KEY=

# EXPLORER_PROVIDER=openai
# EXPLORER_MODEL=
# Custom OpenAI-Completions/Anthropic-compatible endpoint; requires EXPLORER_MODEL.
# EXPLORER_BASE_URL=
# EXPLORER_CONTEXT_WINDOW=128000
# EXPLORER_MAX_TOKENS=4096
# EXPLORER_DB_PATH=data/events.db

# ---- 会话持久化（本地 SQLite） ----
# 对话、已确认行程、运行记录与压缩检查点存进独立的会话库。
# EXPLORER_USER_ID 是本地演示标识：缺省或空白按 "local" 处理；
# 它只是本地 CLI 的写者身份，不是 Web 认证——多用户接入时由调用方
# 提供认证后的 userId（createPersistentPlanner({ userId })）。
# EXPLORER_USER_ID=local
# 会话库路径，与活动库相互独立；和活动库一样是单主机共享文件设计，
# 不是多副本共享存储。
# EXPLORER_SESSION_DB_PATH=data/sessions.db
# CLI 启动时钉住恢复的会话 ID；缺省或空白时每次启动新建对话，并在 stderr
# 打印本次 sessionId。仅调试/回归用途；Web 对话由请求参数指定会话。
# EXPLORER_SESSION_ID=

# ---- Web 演示入口（npm run dev:web；以下全部可选） ----
# 同源托管 frontend/ 并把 /api/chat* 交给 Agent 后端。
# EXPLORER_WEB_HOST=127.0.0.1
# EXPLORER_WEB_PORT=8080
# 除同源外额外信任的 Origin 精确值，逗号分隔（如独立端口的前端调试
# "http://127.0.0.1:5173"）；默认只放行同源 POST。
# EXPLORER_WEB_ALLOWED_ORIGINS=
# 静态根；默认仓库 frontend/。
# EXPLORER_WEB_ROOT=frontend
# 匿名身份：服务端铸随机 chat_uid 写 HttpOnly cookie 区分访客——
# cookie 值本身是凭证，仅 demo 用途，不是真实认证。
# 可选登录（登录与否都能全功能使用；登录后匿名数据并入账号）：
# 启动时播种的管理账号，缺省 admin/admin 仅本地演示；
# 上线必须设置 EXPLORER_ADMIN_PASSWORD。
# 环境变量仅首次创建账号时生效；已有账号不会随环境变量修改而重置密码。
# EXPLORER_ADMIN_USER=
# EXPLORER_ADMIN_PASSWORD=
# https 部署时为登录会话 cookie 加 Secure；本地 http 开发保持缺省。
# EXPLORER_SECURE_COOKIE=1

# ---- 上下文压缩 ----
# 占上下文窗口的触发比例（0,1）。
# EXPLORER_COMPACTION_THRESHOLD=0.8
# 压缩后保留的近期原文 token 预算（不足时整体进摘要）。
# EXPLORER_COMPACTION_KEEP_RECENT_TOKENS=20000
# 摘要请求的输出预算（与普通回复预算 EXPLORER_MAX_TOKENS 相互独立）。
# EXPLORER_COMPACTION_MAX_TOKENS=8192

# ---- 长期记忆蒸馏 ----
# 单次喂给蒸馏模型的消息序列化总长上限（字符）；模型窗口折算更小者生效。
# EXPLORER_MEMORY_INPUT_CHARS=64000
# 会话 close 时机会蒸馏的硬超时（毫秒）；输入较大时须覆盖单请求时延。
# EXPLORER_MEMORY_DISTILL_TIMEOUT_MS=90000
# 无新确认方案时触发蒸馏的保底新增 user 消息条数；有新确认方案（plan
# 标注）不受此门槛限制、立即蒸馏。
# EXPLORER_MEMORY_MIN_USER_MESSAGES=3

# ---- 子 Agent 编排 ----
# 进程级子 Agent 并发信号量上限；超限的派发给队列等待，被取消或超时立即
# 退队不占槽位。
# EXPLORER_SUBAGENT_MAX_CONCURRENT=8
# 单次子 Agent 派发超时（毫秒），自进入 execute（含信号量排队）起算；
# 本地超时触发后取消子任务并向父返回超时结果。
# EXPLORER_SUBAGENT_TIMEOUT_MS=120000

# ---- 高德地图（可选；同时设置 JS Key 与安全密钥后启用） ----
# 安全密钥只在服务器通过 /_AMapService 代理使用，不写进静态前端。
AMAP_JS_KEY=
AMAP_SECURITY_JSCODE=
# AMAP_STYLE=amap://styles/fresh
# 当前后端统一 GCJ-02；仅接旧 WGS 后端时显式设 WGS84。
# AMAP_BACKEND_COORDINATE_SYSTEM=GCJ02
# 后端 REST 算路使用下面的 EXPLORER_AMAP_KEY（Web服务 Key）。

# ---- 高德站间算路（可选） ----
# Web 服务 REST key；配置后启用 estimate_travel 工具与行程 legs 真实道路
# 轨迹。缺省时全链路降级：工具不挂载、legs status 记 skipped，不阻塞规划。
# EXPLORER_AMAP_KEY=
# 公交算路接口的必填 city 参数（城市名或 citycode）；西安演示填 EXPLORER_AMAP_TRANSIT_CITY=西安。
# 缺省时公交请求不带 city（多半报错降级为 error leg）；步行不受影响。
# EXPLORER_AMAP_TRANSIT_CITY=
# 站间直线距离阈值（米）：≤ 用步行算路，否则用公交；缺省 3000。
# EXPLORER_ROUTE_TRANSIT_THRESHOLD_M=3000

# ---- 联网搜索（可选） ----
# DeepSeek Search API key（POST /v1/tools/search）；配置后主 Agent 挂
# web_search 工具，仅用于本地库无匹配的长尾需求与排队/预约/临时闭馆/
# 口碑等实时主观信息补盲。缺省时不挂工具，不影响规划。
# 未设置时回退读取下方夜间采集共用的 DEEPSEEK_API_KEY（同一 DeepSeek
# 账户 key）；要单独控制就显式设本变量。
# EXPLORER_WEB_SEARCH_KEY=

# ---- Offline Xi'an data collection (not the planner model key) ----
# Copy this file to local .env; never commit .env or paste keys into dataset files.
# DeepSeek is used for web search and deepseek-flash extraction.
# Qovia is retired; only Xiaohongshu MediaCrawler sessions are currently enabled.
DEEPSEEK_API_KEY=
# Model used to extract activity facts; search and extraction share DEEPSEEK_API_KEY.
EXPLORER_COLLECTION_MODEL=deepseek-flash
# Optional: server-side AMap Web Service key for verified POI/geocoding.
# Offline tests inject responses and never require a real key.
AMAP_WEB_KEY=
# SiliconFlow OCR only; independent of DEEPSEEK_API_KEY. Never commit the real key.
SILICONFLOW_API_KEY=
SILICONFLOW_OCR_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_OCR_MODEL=deepseek-ai/DeepSeek-OCR
SILICONFLOW_OCR_TIMEOUT_MS=60000
SILICONFLOW_OCR_CONCURRENCY=2
SILICONFLOW_OCR_MAX_TOKENS=4096
# Raw responses, temporary files and extraction drafts stay under this ignored path.
# EXPLORER_COLLECTION_WORK_DIR=.local-data/xian
