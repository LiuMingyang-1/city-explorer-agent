{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "xian-events/4"
    },
    "base_date": {
      "type": "string",
      "minLength": 1
    },
    "days": {
      "const": 14
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^xa_[0-9a-f]{32}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "展览",
              "音乐现场",
              "演出",
              "市集",
              "节庆活动",
              "书店活动",
              "讲座",
              "工作坊",
              "放映",
              "景点参观",
              "户外活动",
              "体育赛事",
              "1A",
              "2A",
              "3A",
              "4A",
              "5A",
              "暂无评级"
            ]
          },
          "venue_name": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "string",
            "minLength": 1
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "start_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "end_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "suggested_duration_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 1440
          },
          "budget_min": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "budget_max": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "currency": {
            "const": "CNY"
          },
          "budget_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "guide_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "thumbnail_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "uniqueItems": true
          },
          "record_type": {
            "enum": [
              "activity",
              "attraction"
            ]
          },
          "city": {
            "type": "string"
          },
          "amap_poi_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "schedule_json": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "timezone",
              "mode"
            ],
            "properties": {
              "timezone": {
                "const": "Asia/Shanghai"
              },
              "mode": {
                "enum": [
                  "weekly",
                  "dates",
                  "always_open",
                  "unknown"
                ]
              },
              "weekly": {
                "type": "array",
                "maxItems": 14,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "weekdays",
                    "windows"
                  ],
                  "properties": {
                    "weekdays": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 7,
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 7
                      }
                    },
                    "valid_from": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "valid_to": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "windows": {
                      "type": "array",
                      "maxItems": 24,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "start",
                          "end"
                        ],
                        "properties": {
                          "start": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "end": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "end_day_offset": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "last_entry": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              },
              "dates": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "date"
                  ],
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "closed": {
                      "type": "boolean"
                    },
                    "windows": {
                      "type": "array",
                      "maxItems": 24,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "start",
                          "end"
                        ],
                        "properties": {
                          "start": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "end": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "end_day_offset": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "last_entry": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              },
              "exceptions": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "date"
                  ],
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "closed": {
                      "type": "boolean"
                    },
                    "windows": {
                      "type": "array",
                      "maxItems": 24,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "start",
                          "end"
                        ],
                        "properties": {
                          "start": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "end": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "end_day_offset": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "last_entry": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              },
              "note": {
                "type": "string",
                "maxLength": 2000
              }
            }
          },
          "status": {
            "enum": [
              "active",
              "paused",
              "cancelled",
              "ended",
              "unknown"
            ]
          },
          "source_published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_updated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "fetched_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "time_note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 10000
          },
          "time_status": {
            "enum": [
              "complete",
              "partial",
              "unknown",
              "conflicting"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "category",
          "venue_name",
          "address",
          "latitude",
          "longitude",
          "start_at",
          "end_at",
          "suggested_duration_minutes",
          "budget_min",
          "budget_max",
          "currency",
          "budget_note",
          "guide_url",
          "thumbnail_url",
          "image_urls"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "record_type"
              ],
              "properties": {
                "record_type": {
                  "const": "attraction"
                }
              }
            },
            "then": {
              "properties": {
                "category": {
                  "enum": [
                    "1A",
                    "2A",
                    "3A",
                    "4A",
                    "5A",
                    "暂无评级"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "category": {
                  "enum": [
                    "展览",
                    "音乐现场",
                    "演出",
                    "市集",
                    "节庆活动",
                    "书店活动",
                    "讲座",
                    "工作坊",
                    "放映",
                    "景点参观",
                    "户外活动",
                    "体育赛事"
                  ]
                }
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 5000
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "source_event_key": {
            "type": "string",
            "minLength": 1
          },
          "venue_key": {
            "type": "string",
            "minLength": 1
          },
          "schedule_type": {
            "enum": [
              "window",
              "fixed",
              "unknown"
            ]
          },
          "source_kind": {
            "enum": [
              "publisher",
              "ticketing",
              "organizer_social",
              "unverified"
            ]
          },
          "verified_at": {
            "type": "string",
            "minLength": 1
          },
          "city": {
            "const": "西安市"
          },
          "city_evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_url",
              "quote"
            ]
          },
          "coordinates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "system": {
                "const": "GCJ-02"
              },
              "source_url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "method": {
                "enum": [
                  "source",
                  "existing_verified",
                  "geocoding"
                ]
              },
              "input_system": {
                "enum": [
                  "WGS-84",
                  "GCJ-02",
                  "BD-09"
                ]
              },
              "conversion": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "system",
              "source_url",
              "method",
              "input_system",
              "conversion"
            ]
          },
          "duration_basis": {
            "enum": [
              "source",
              "estimated",
              "unknown"
            ]
          },
          "duration_note": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "enum": [
                    "title",
                    "venue_name",
                    "address",
                    "start_at",
                    "end_at",
                    "budget_min",
                    "budget_max",
                    "suggested_duration_minutes"
                  ]
                },
                "source_url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "document_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "field",
                "source_url",
                "quote",
                "document_sha256"
              ]
            },
            "minItems": 0
          },
          "source_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "slot_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "event_id",
          "source_event_key",
          "venue_key",
          "schedule_type",
          "source_kind",
          "verified_at",
          "city",
          "city_evidence",
          "coordinates",
          "duration_basis",
          "duration_note",
          "evidence",
          "source_url",
          "slot_key"
        ]
      },
      "minItems": 1,
      "maxItems": 5000
    }
  },
  "required": [
    "schema_version",
    "base_date",
    "days",
    "events",
    "provenance"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://city-explorer.invalid/contracts/xian-events/3/dataset.schema.json"
}
