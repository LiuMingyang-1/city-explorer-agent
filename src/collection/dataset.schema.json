{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "xian-events/3"
    },
    "base_date": {
      "type": "string",
      "minLength": 1
    },
    "days": {
      "const": 14
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^xa_[0-9a-f]{32}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "展览",
              "音乐现场",
              "演出",
              "市集",
              "节庆活动",
              "书店活动",
              "讲座",
              "工作坊",
              "放映",
              "景点参观",
              "户外活动",
              "体育赛事"
            ]
          },
          "venue_name": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "string",
            "minLength": 1
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "start_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "end_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "suggested_duration_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 1440
          },
          "budget_min": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "budget_max": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "currency": {
            "const": "CNY"
          },
          "budget_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "guide_url": {
            "type": "null"
          },
          "thumbnail_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "category",
          "venue_name",
          "address",
          "latitude",
          "longitude",
          "start_at",
          "end_at",
          "suggested_duration_minutes",
          "budget_min",
          "budget_max",
          "currency",
          "budget_note",
          "guide_url",
          "thumbnail_url",
          "image_urls"
        ]
      },
      "minItems": 1,
      "maxItems": 5000
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "source_event_key": {
            "type": "string",
            "minLength": 1
          },
          "venue_key": {
            "type": "string",
            "minLength": 1
          },
          "schedule_type": {
            "enum": [
              "window",
              "fixed",
              "unknown"
            ]
          },
          "source_kind": {
            "enum": [
              "publisher",
              "ticketing",
              "organizer_social",
              "unverified"
            ]
          },
          "verified_at": {
            "type": "string",
            "minLength": 1
          },
          "city": {
            "const": "西安市"
          },
          "city_evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_url",
              "quote"
            ]
          },
          "coordinates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "system": {
                "const": "WGS-84"
              },
              "source_url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "method": {
                "enum": [
                  "source",
                  "existing_verified",
                  "geocoding"
                ]
              },
              "input_system": {
                "enum": [
                  "WGS-84",
                  "GCJ-02",
                  "BD-09"
                ]
              },
              "conversion": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "system",
              "source_url",
              "method",
              "input_system",
              "conversion"
            ]
          },
          "duration_basis": {
            "enum": [
              "source",
              "unknown"
            ]
          },
          "duration_note": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "enum": [
                    "title",
                    "venue_name",
                    "address",
                    "start_at",
                    "end_at",
                    "budget_min",
                    "budget_max",
                    "suggested_duration_minutes"
                  ]
                },
                "source_url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "document_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "field",
                "source_url",
                "quote",
                "document_sha256"
              ]
            },
            "minItems": 3
          },
          "source_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "slot_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "event_id",
          "source_event_key",
          "venue_key",
          "schedule_type",
          "source_kind",
          "verified_at",
          "city",
          "city_evidence",
          "coordinates",
          "duration_basis",
          "duration_note",
          "evidence",
          "source_url",
          "slot_key"
        ]
      },
      "minItems": 1,
      "maxItems": 5000
    }
  },
  "required": [
    "schema_version",
    "base_date",
    "days",
    "events",
    "provenance"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://city-explorer.invalid/contracts/xian-events/3/dataset.schema.json"
}
